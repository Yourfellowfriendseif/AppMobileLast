<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.tp1appmobil">

    <!-- Internet permission (already present) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tp1AppMobil">

        <!-- LoginActivity (NEW LAUNCHER) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SplashActivity (Remove launcher intent-filter) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true" /> <!-- No longer the launcher -->

        <!-- MainActivity -->
        <activity android:name=".MainActivity" />

        <!-- RegisterActivity (Add if needed) -->
        <activity android:name=".RegisterActivity" />
    </application>

</manifest>